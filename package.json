{
  "name": "dsh-sandbox-allowlist",
  "version": "0.3.0-beta.2",
  "description": "DSH sandbox extension: configurable trusted writable roots outside the workspace, read restrictions, and capability-based command allow-listing for sandboxed CLI commands. 为 DSH 默认沙箱增加「沙箱授权目录」「禁读规则」与按能力类判定的「命令放行」规则。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerdh/dsh-sandbox-allowlist.git"
  },
  "type": "module",
  "exports": {
    ".": "./lib/policy.mjs",
    "./client": "./lib/client.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/test.mjs",
    "test:dry-mount": "node test/dry-mount.mjs",
    "test:patch": "node test/validate-patch.mjs",
    "test:command-gate": "node test/verify-command-gate.mjs",
    "test:approval-gate": "node test/verify-approval-gate.mjs",
    "test:matrix": "node test/verify-command-matrix.mjs",
    "test:read-gate": "node test/verify-read-restriction.mjs",
    "test:client": "node test/verify-client-editor.mjs",
    "typecheck": "tsc --noEmit",
    "build:client": "tsc -p tsconfig.build.json && tsdown",
    "prepublishOnly": "npm test && npm run test:command-gate && npm run test:approval-gate && npm run test:matrix && npm run test:read-gate && npm run test:client"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-app-boot": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-fs": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-fs-sandbox": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox-local": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox-windows-acl": "^0.1.5-rc.2",
    "tsdown": "^0.7.0",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "sandbox",
    "allowlist"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  }
}
